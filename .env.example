# ==============================================================================
# Google Cloud Agent Security & Governance Demo — Environment Configuration
# Copy to .env (`cp .env.example .env`) or export variables directly in shell.
# ==============================================================================

# Required: Your GCP Project ID (auto-detected from `gcloud config get-value project` if omitted)
PROJECT_ID=your-gcp-project-id

# Optional: Auto-detected via `gcloud projects describe` / `get-ancestors` during deploy if omitted
PROJECT_NUMBER=
ORG_ID=

# Region & Model Configuration
REGION=us-central1
MODEL_LOCATION=global
MODEL_NAME=gemini-3.8-flash

# Optional: VPC / Subnet for AgentConnectivityTemplate & Egress Gateway (infra/02)
NETWORK_NAME=default
SUBNET_NAME=default

# Governance Resource Names (customizable defaults)
ARTIFACT_REPO_NAME=agent-gov-repo
INGRESS_GATEWAY_NAME=ingress-gw
EGRESS_GATEWAY_NAME=liveops-egress-gw
MODEL_ARMOR_TEMPLATE_ID=agent-gov-ma-template
UAP_POLICY_ID=liveops-egress-uap-policy
SGP_POLICY_ID=liveops-compensation-cap-policy

# Optional: Gemini Enterprise App ID (only needed for infra/08_register_gemini_enterprise.sh)
GEMINI_ENTERPRISE_APP_ID=

# ==============================================================================
# Auto-populated by deployment scripts (infra/03 & infra/06) — leave blank initially
# ==============================================================================
MCP_URL=
SRE_URL=
BILLING_URL=
ORCHESTRATOR_ENGINE_ID=
ORCHESTRATOR_RESOURCE_NAME=
ORCHESTRATOR_SPIFFE_ID=
